<Window x:Class="Sputnik.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Спутник" Width="450" Height="490" MinWidth="300" MinHeight="240" Background="#222C35" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
  <Border x:Name="Frame" TextElement.FontFamily="{DynamicResource ThemeFont}" BorderBrush="{DynamicResource ThemeEdge}" Background="{DynamicResource ThemeSurface}" BorderThickness="1">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="34" Background="{DynamicResource ThemeSurface}" MouseLeftButtonDown="DragHeader">
        <TextBlock Text="Спутник" Foreground="{DynamicResource ThemeAccent}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/>
        <Button HorizontalAlignment="Right" Width="42" Background="Transparent" Foreground="{DynamicResource ThemeInk}" Click="HidePanel" AutomationProperties.Name="Закрыть окно" Content="×">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Fill" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
      <Grid x:Name="BrowserHost"/>
    </DockPanel>
  </Border>
</Window>
