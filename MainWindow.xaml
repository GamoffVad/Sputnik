<Window x:Class="Sputnik.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Спутник" Width="450" Height="490" MinWidth="300" MinHeight="240" Background="#222C35" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFrame" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFrame" Property="Opacity" Value="0.62"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFrame" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource ThemeBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeEdge}"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="7,4"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource ThemeBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeEdge}"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="7,4"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="7,4"/></Style>
  </Window.Resources>
  <Border x:Name="Frame" TextElement.FontFamily="{DynamicResource ThemeFont}" BorderBrush="{DynamicResource ThemeEdge}" Background="{DynamicResource ThemeSurface}" BorderThickness="1">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="34" Background="{DynamicResource ThemeSurface}" MouseLeftButtonDown="DragHeader">
        <TextBlock Text="Спутник" Foreground="{DynamicResource ThemeAccent}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/>
        <Button HorizontalAlignment="Right" Width="42" Padding="0" Background="Transparent" Foreground="{DynamicResource ThemeInk}" Click="HidePanel" AutomationProperties.Name="Закрыть окно" Content="×">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Fill" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
      <ContentControl x:Name="PanelHost" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </DockPanel>
  </Border>
</Window>
