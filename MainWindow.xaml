<Window x:Class="Sputnik.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Спутник" Width="438" Height="432" MinWidth="300" MinHeight="240"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border x:Name="Frame" TextElement.FontFamily="{DynamicResource ThemeFont}"
          BorderBrush="{DynamicResource ThemeEdge}" Background="{DynamicResource ThemeSurface}" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="34" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeLine}"
              Background="{DynamicResource ThemeRaised}" MouseLeftButtonDown="DragHeader">
        <Grid Margin="13,0,4,0">
          <TextBlock Text="Спутник" Foreground="{DynamicResource ThemeMuted}" FontSize="12"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Style="{StaticResource SputnikIconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Click="HidePanel" AutomationProperties.Name="Закрыть окно" ToolTip="Закрыть окно (Esc)">
            <Path Data="M1 1 L9 9 M9 1 L1 9" Width="9" Height="9" Stretch="Uniform" StrokeThickness="1.4"
                  Stroke="{DynamicResource ThemeInk}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </Grid>
      </Border>
      <ContentControl x:Name="PanelHost" IsTabStop="False" HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"/>
    </DockPanel>
  </Border>
</Window>
