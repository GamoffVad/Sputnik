<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.3.28.31</Version>
    <ApplicationIcon>Sputnik.ico</ApplicationIcon>
    <TargetFramework Condition="'$(Win7)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(Win7)' == 'true'">net48</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/$(Configuration)/$(TargetFramework)/</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;tests/**;bin/**;obj/**</DefaultItemExcludes>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="wwwroot/assets/**/*" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
  <PropertyGroup Condition="'$(Win7)' == 'true'">
    <LangVersion>14.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup Condition="'$(Win7)' == 'true'">
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all"/>
    <PackageReference Include="System.Net.Http.Json" Version="10.0.5"/>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
