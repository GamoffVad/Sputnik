<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="SputnikControl" TargetType="{x:Type Control}">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ThemeFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="SputnikStatus" TargetType="{x:Type TextBlock}">
    <Setter Property="Margin" Value="0,3,0,0"/>
    <Style.Triggers>
      <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SputnikControl}">
    <Setter Property="Background" Value="{DynamicResource ThemeRaised}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="7"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ThemeEdge}"/>
              <Setter TargetName="Face" Property="Opacity" Value=".88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".69"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".48"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SputnikPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentInk}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="SputnikIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="28"/>
  </Style>

  <ControlTemplate x:Key="SputnikTextEditor" TargetType="{x:Type Control}">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".48"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="SputnikField" TargetType="{x:Type Control}" BasedOn="{StaticResource SputnikControl}">
    <Setter Property="Background" Value="{DynamicResource ThemeField}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource SputnikField}">
    <Setter Property="Template" Value="{StaticResource SputnikTextEditor}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ThemeInk}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccent}"/>
    <Setter Property="SelectionOpacity" Value=".37"/>
  </Style>
  <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource SputnikField}">
    <Setter Property="Template" Value="{StaticResource SputnikTextEditor}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ThemeInk}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccent}"/>
    <Setter Property="SelectionOpacity" Value=".37"/>
  </Style>
  <Style TargetType="{x:Type RichTextBox}" BasedOn="{StaticResource SputnikControl}">
    <Setter Property="Template" Value="{StaticResource SputnikTextEditor}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ThemeInk}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccent}"/>
    <Setter Property="SelectionOpacity" Value=".37"/>
  </Style>

  <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SputnikControl}">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinHeight" Value="25"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
            <DockPanel LastChildFill="True">
              <Border x:Name="Mark" DockPanel.Dock="Left" VerticalAlignment="Center" Width="16" Height="16"
                      Margin="2,0,8,0" Background="{DynamicResource ThemeField}"
                      BorderBrush="{DynamicResource ThemeEdge}" BorderThickness="1" CornerRadius="4">
                <Grid>
                  <Path x:Name="Tick" Width="9" Height="7" Stretch="Fill" Data="M0 4 L3 7 L9 0"
                        Stroke="{DynamicResource ThemeAccentInk}" StrokeThickness="1.45"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                  <Rectangle x:Name="Dash" Width="8" Height="2" RadiusX="1" RadiusY="1"
                             Fill="{DynamicResource ThemeAccentInk}" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Mark" Property="Background" Value="{DynamicResource ThemeAccent}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Mark" Property="Background" Value="{DynamicResource ThemeAccent}"/>
              <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value=".48"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SputnikTrackButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SputnikScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Background" Value="{DynamicResource ThemeEdge}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="Transparent">
            <Border x:Name="Rail" Background="{TemplateBinding Background}" CornerRadius="3" Margin="3,1"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rail" Property="Background" Value="{DynamicResource ThemeAccent}"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Rail" Property="Background" Value="{DynamicResource ThemeAccent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Width" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource SputnikTrackButton}" Command="ScrollBar.PageUpCommand"/>
            </Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource SputnikScrollThumb}" MinHeight="17"/></Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource SputnikTrackButton}" Command="ScrollBar.PageDownCommand"/>
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SputnikTrackButton}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource SputnikScrollThumb}" MinWidth="17"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SputnikTrackButton}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type ScrollViewer}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollViewer}">
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}" Margin="{TemplateBinding Padding}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                       Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                       Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource SputnikControl}">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Border x:Name="Focus" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="3,0">
            <Grid>
              <Border Height="3" Background="{DynamicResource ThemeLine}" CornerRadius="2"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SputnikTrackButton}" Command="Slider.DecreaseLarge">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"><Border Height="3" CornerRadius="2" Background="{DynamicResource ThemeEdge}"/></Border>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeSurface}"
                                BorderThickness="2" CornerRadius="7"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SputnikTrackButton}" Command="Slider.IncreaseLarge"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Focus" Property="Opacity" Value=".48"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
<Style x:Key="SputnikDropdownText" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource SputnikControl}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border x:Name="Item" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
            <DockPanel>
              <Path x:Name="Tick" DockPanel.Dock="Right" Width="9" Height="7" Stretch="Fill" Data="M0 4 L3 7 L9 0"
                    Stroke="{DynamicResource ThemeInk}" StrokeThickness="1.45" Margin="6,0,1,0" Visibility="Collapsed"/>
              <ContentPresenter VerticalAlignment="Center" ClipToBounds="True" RecognizesAccessKey="True"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource ThemeRaised}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Item" Property="Opacity" Value=".48"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SputnikField}">
    <Setter Property="MaxDropDownHeight" Value="246"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    <Setter Property="ItemsPanel">
      <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
            <ContentPresenter x:Name="Selection" Margin="9,0,31,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" ClipToBounds="True"/>
            <ToggleButton x:Name="OpenList" Focusable="False" ClickMode="Press" IsTabStop="False"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Background="Transparent">
                    <Path x:Name="Chevron" Data="M0 0 L4 4 8 0" Stroke="{DynamicResource ThemeMuted}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource ThemeInk}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M0 4 L4 0 8 4"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource SputnikDropdownText}" Margin="9,2,29,2"
                     IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Collapsed"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" VerticalOffset="4"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeEdge}"
                      BorderThickness="1" CornerRadius="9" Padding="4"
                      Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      TextElement.FontFamily="{DynamicResource ThemeFont}">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeEdge}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Field" Property="Opacity" Value=".48"/>
              <Setter TargetName="Selection" Property="Opacity" Value=".48"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SputnikCalendarDay" TargetType="{x:Type CalendarDayButton}" BasedOn="{StaticResource SputnikControl}">
    <Setter Property="Margin" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CalendarDayButton}">
          <Border x:Name="Day" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/></Trigger>
            <Trigger Property="IsToday" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="{DynamicResource ThemeEdge}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Day" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Day" Property="Background" Value="{DynamicResource ThemeAccent}"/>
              <Setter TargetName="Day" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
              <Setter Property="Foreground" Value="{DynamicResource ThemeAccentInk}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="{DynamicResource ThemeEdge}"/></Trigger>
            <Trigger Property="IsBlackedOut" Value="True"><Setter TargetName="Day" Property="Opacity" Value=".32"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Day" Property="Opacity" Value=".32"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SputnikCalendarPeriod" TargetType="{x:Type CalendarButton}" BasedOn="{StaticResource SputnikControl}">
    <Setter Property="Margin" Value="2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CalendarButton}">
          <Border x:Name="Period" Background="{DynamicResource ThemeRaised}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Period" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
            <Trigger Property="HasSelectedDays" Value="True">
              <Setter TargetName="Period" Property="Background" Value="{DynamicResource ThemeAccent}"/>
              <Setter Property="Foreground" Value="{DynamicResource ThemeAccentInk}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True"><Setter TargetName="Period" Property="BorderBrush" Value="{DynamicResource ThemeEdge}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Period" Property="Opacity" Value=".32"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SputnikCalendarItem" TargetType="{x:Type CalendarItem}" BasedOn="{StaticResource SputnikControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CalendarItem}">
          <ControlTemplate.Resources>
            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
              <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource ThemeMuted}" FontSize="11"/>
            </DataTemplate>
          </ControlTemplate.Resources>
          <Grid x:Name="PART_Root">
            <Border Padding="7" CornerRadius="9" Background="{DynamicResource ThemeSurface}"
                    BorderBrush="{DynamicResource ThemeEdge}" BorderThickness="1">
              <DockPanel Width="224">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                  <Button x:Name="PART_PreviousButton" DockPanel.Dock="Left" Style="{StaticResource SputnikIconButton}" AutomationProperties.Name="Назад">
                    <Path Data="M5 1 L1 5 5 9" Stroke="{DynamicResource ThemeInk}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                  </Button>
                  <Button x:Name="PART_NextButton" DockPanel.Dock="Right" Style="{StaticResource SputnikIconButton}" AutomationProperties.Name="Вперёд">
                    <Path Data="M1 1 L5 5 1 9" Stroke="{DynamicResource ThemeInk}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                  </Button>
                  <Button x:Name="PART_HeaderButton" Background="Transparent" FontWeight="SemiBold" Padding="2,0"/>
                </DockPanel>
                <Grid Height="196">
                  <Grid x:Name="PART_MonthView" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                      <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="22"/><RowDefinition/><RowDefinition/><RowDefinition/>
                      <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                  </Grid>
                  <Grid x:Name="PART_YearView" Visibility="Hidden">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  </Grid>
                </Grid>
              </DockPanel>
            </Border>
            <Border x:Name="PART_DisabledVisual" Visibility="Collapsed" CornerRadius="9"
                    Background="{DynamicResource ThemeSurface}" Opacity=".65"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SputnikCalendar" TargetType="{x:Type Calendar}" BasedOn="{StaticResource SputnikControl}">
    <Setter Property="CalendarItemStyle" Value="{StaticResource SputnikCalendarItem}"/>
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource SputnikCalendarDay}"/>
    <Setter Property="CalendarButtonStyle" Value="{StaticResource SputnikCalendarPeriod}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Calendar}">
          <StackPanel x:Name="PART_Root">
            <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type DatePickerTextBox}" BasedOn="{StaticResource SputnikDropdownText}"/>
  <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource SputnikField}">
    <Setter Property="CalendarStyle" Value="{StaticResource SputnikCalendar}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type DatePicker}">
          <Grid x:Name="PART_Root">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
            <DockPanel Margin="8,1,2,1">
              <Button x:Name="PART_Button" DockPanel.Dock="Right" Style="{StaticResource SputnikIconButton}" Focusable="False"
                      AutomationProperties.Name="Открыть календарь">
                <Path Data="M2 4 H14 V14 H2 Z M2 7 H14 M5 2 V5 M11 2 V5 M5 10 H7"
                      Stroke="{DynamicResource ThemeMuted}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round"/>
              </Button>
              <DatePickerTextBox x:Name="PART_TextBox" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"/>
            </DockPanel>
            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True"
                   Focusable="False" StaysOpen="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeEdge}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
            <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Root" Property="Opacity" Value=".48"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
